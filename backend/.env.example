# Copy locally; never commit real secrets. This is self-hosted PostgreSQL, not Supabase.
DATABASE_URL=postgresql://malaga:change-this-local-password@127.0.0.1:5432/malaga
HOST=127.0.0.1
PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8080
UPLOAD_DIR=./data/uploads
# Required in production; use a cryptographically random value at least 32 characters long.
# IMAGE_SIGNING_SECRET=
# Exact browser origins, comma-separated. Localhost HTTP origins accepted only in development.
CORS_ORIGINS=http://localhost:3000
INITIAL_MOCK_POINTS=1000
SESSION_TTL_SECONDS=604800
# Keep false on shared/production systems. Only used by npm run seed:dev.
ALLOW_DEV_SEED=false
# Account delivery defaults OFF and returns MAIL_UNAVAILABLE, never a sent claim.
# local_sink writes synthetic @example.com/.test/.invalid mail only, development only.
MAIL_MODE=disabled
MAIL_SINK_DIR=./data/mail-sink
# Required for local_sink or sendmail; users can copy the code in the message.
ACCOUNT_ACTION_URL=http://localhost:3000/account
# Production must explicitly select a verification policy and configure sendmail.
EMAIL_VERIFICATION_POLICY=optional
# MAIL_FROM=accounts@your-owned-domain.example
# SENDMAIL_PATH=/usr/sbin/sendmail
# Optional moderation phrase list as a JSON array. [] explicitly disables it.
# TEXT_FILTER_TERMS_JSON=["operator-selected phrase"]
